{
  "name": "azure-devops-review",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --prefix azure-tab",
    "package": "npm run package --prefix azure-tab",
    "test": "npm run test:core && npm run test:extension",
    "test:core": "node --test tests/*.test.mjs",
    "test:extension": "npm test --prefix azure-tab",
    "test:browser-roslyn": "npm test --prefix browser-roslyn"
  },
  "dependencies": {
    "editorconfig": "3.0.2",
    "fast-xml-parser": "5.11.2",
    "re2js": "2.8.8"
  }
}
